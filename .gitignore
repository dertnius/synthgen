# Build output
bin/
obj/
*.user
.vs/

# Generated local databases and workspace scratch
scratch/

# Derived offline NuGet feed (regenerate with scripts/export-offline-feed.ps1)
offline-packages/

# Local NuGet cache when globalPackagesFolder is redirected into the repo
.nuget-packages/

# Machine-specific enterprise config (generated by scripts/setup-enterprise.ps1)
NuGet.config
NuGet.config.bak
enterprise-profile.local.psd1

# Transferred conda archives for air-gapped provisioning
offline-conda-pkgs/

# SQLite files anywhere else
*.db
*.db-journal

# pfandwerk local run artifacts. A completed run's outputs (plan.json, plan.approved,
# patches.jsonl, facts.json, report.md, trajectory/) are committed deliberately with
# `git add -f` so the CI notary can audit them; scratch from incomplete runs is not.
artifacts/

# Agent-drafted rule proposals. The reviewed rules/gaps.yaml is the artifact worth keeping;
# these are working files a person edits down before opening an MR.
rules/drafts/*.yaml
