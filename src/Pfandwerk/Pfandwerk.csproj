<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pfandwerk</AssemblyName>
    <RootNamespace>Pfandwerk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity naming and JSON typing are implementation details worth testing directly
         without making them part of the public surface. -->
    <InternalsVisibleTo Include="Pfandwerk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SynthGen.Core\SynthGen.Core.csproj" />
    <ProjectReference Include="..\SynthGen.Sqlite\SynthGen.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .sql files are the source of truth for the ledger schema: one copy a DBA can
         run by hand, embedded here so the code cannot drift from it. -->
    <EmbeddedResource Include="..\..\db\pfandwerk\ledger.sql" LogicalName="ledger.sql" />
    <EmbeddedResource Include="..\..\db\pfandwerk\ledger.sqlite.sql" LogicalName="ledger.sqlite.sql" />
  </ItemGroup>

</Project>
